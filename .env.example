# Copy this file to ".env" and fill in your key. NEVER share or commit your .env file.

# Which AI provider to use: groq | azure | mock
# (If empty: uses groq when GROQ_API_KEY is set, else azure if set, else mock)
LLM_PROVIDER=groq

# ---- Groq (free) : https://console.groq.com/keys ----
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ---- Azure OpenAI (optional, only if you get access later) ----
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
